$RESOURCE_GROUP="rg-bicep-deploy"
$LOCATION="eastus"

dotnet build
Compress-Archive .\bin\Debug\net8.0\* .\out\app.zip -Force

az group crate --name $RESOURCE_GROUP --location $LOCATION
az deployment group create --resource-group $RESOURCE_GROUP --template-file .infra/main.bicep
$FUNCTION_APP_NAME=(az deployment group show --resource-group $RESOURCE_GROUP --name main --query properties.outputs.functionAppName.value -o tsv)
az functionapp deployment source config-zip --resource-group $RESOURCE_GROUP --name $FUNCTION_APP_NAME --src .\out\app.zip